# Lucid — see docs/WORKPLAN.md §2
# Patterns are unanchored and case-bracketed so they match whether the Unity
# project folder is `lucid/` or `Lucid/`.

# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore meta data for assets that are committed
!/[Aa]ssets/**/*.meta

# Autogenerated project files (Rider / VS / VS Code)
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Unity build artefacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage

# Addressables (spec §14) — generated bundles and catalogues
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
[Ss]erver[Dd]ata/

# Steam — the app id is the owner's, dev builds carry their own (spec §14)
steam_appid.txt

# Replay / telemetry logs are generated per round; attach them to issues
# rather than committing them (docs/WORKPLAN.md M1.12).
*.lucidlog

# Fetched assets (rule 5 / spec §17): assets listed in assets.manifest.json are
# downloaded by tools/fetch-assets.py and must never be committed. The download
# destination is settled when that tool is written (M0.3); add its pattern here
# then. Committed CC0/CC-BY assets live in each cube's assets/ and stay tracked.

# OS
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
