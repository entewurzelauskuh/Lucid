# Normalise line endings; let git decide what is text.
* text=auto

# Unity YAML. Never hand-edited (CLAUDE.md rule 4), but keep it diffable.
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.meta      text eol=lf
*.asmdef    text eol=lf
*.shader    text eol=lf
*.cs        text eol=lf diff=csharp

# Shell scripts must keep LF or they break on macOS and Linux.
*.sh        text eol=lf

# Git LFS — binary content (docs/WORKPLAN.md §2).
*.png       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.jpeg      filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.exr       filter=lfs diff=lfs merge=lfs -text
*.tga       filter=lfs diff=lfs merge=lfs -text
*.fbx       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text

# ...except the concept art, which is deliberately a plain blob. GitHub serves
# README images through the LFS bandwidth quota, so ten of them on the front
# page would spend it on people merely reading about the game. These are
# write-once and web-sized; ordinary git objects cost nothing to look at.
docs/concept/*.jpg -filter -diff -merge

# Generated previews and docs are not diffable prose.
docs/playtests/*.csv linguist-generated=true
