<?xml version="1.0" encoding="utf-8"?>
<!-- Spectator — structure only. Styling lives in lucid-tokens.uss + lucid-components.uss. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lucid="Lucid.UI">
  <Style src="project:///Assets/_Lucid/UI/Styles/lucid-tokens.uss" />
  <Style src="project:///Assets/_Lucid/UI/Styles/lucid-components.uss" />
  <ui:VisualElement name="spectator-root" picking-mode="Ignore" style="flex-grow:1;">
    <ui:VisualElement name="watch-frame" picking-mode="Ignore" class="watch-frame" />
    <ui:VisualElement name="status" style="position:absolute; left:48px; top:48px; flex-direction:row; align-items:center;">
      <ui:Label name="your-fate" text="You were consumed" class="spectator__fate" />
      <ui:Label text="watching" class="spectator__lead" />
      <ui:VisualElement name="watched-marker" />
    </ui:VisualElement>
    <lucid:TimerArc name="dawn" class="timer-arc" style="position:absolute; top:24px; left:50%; translate:-50% 0;" />
    <ui:VisualElement name="toasts" style="position:absolute; top:48px; right:48px; align-items:flex-end;" />
    <ui:VisualElement name="watched-vitals" style="position:absolute; left:48px; bottom:48px; flex-direction:row; align-items:center;" />
    <ui:VisualElement name="switcher" style="position:absolute; bottom:48px; left:50%; translate:-50% 0; flex-direction:row;" />
  </ui:VisualElement>
</ui:UXML>
