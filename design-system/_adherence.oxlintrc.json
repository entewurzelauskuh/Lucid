{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/hud/**",
              "components/lobby/**",
              "components/nightmare/**",
              "ui_kits/lucid-game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Inter))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|hotkey|disabled|reason|full|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, hotkey, disabled, reason, full, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CooldownRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|size|thickness|tone|label|children|style|key|ref|className|style|children)$/]",
        "message": "<CooldownRing> doesn't accept that prop. Declared props: progress, size, thickness, tone, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CooldownRing'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:exit|fog|danger)$/]",
        "message": "<CooldownRing> tone must be one of 'exit' | 'fog' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CostBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:cost|affordable|budget|size|style|key|ref|className|style|children)$/]",
        "message": "<CostBadge> doesn't accept that prop. Declared props: cost, affordable, budget, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CostBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CostBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crosshair'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|progress|size|style|key|ref|className|style|children)$/]",
        "message": "<Crosshair> doesn't accept that prop. Declared props: state, progress, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crosshair'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|mob|weak-point)$/]",
        "message": "<Crosshair> state must be one of 'idle' | 'mob' | 'weak-point'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DamageArc'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|intensity|style|key|ref|className|style|children)$/]",
        "message": "<DamageArc> doesn't accept that prop. Declared props: from, intensity, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:hp|max|regen|size|showNumber|style|key|ref|className|style|children)$/]",
        "message": "<HealthRing> doesn't accept that prop. Declared props: hp, max, regen, size, showNumber, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='MistPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|aside|tone|pad|edge|children|style|key|ref|className|style|children)$/]",
        "message": "<MistPanel> doesn't accept that prop. Declared props: title, aside, tone, pad, edge, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MistPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:panel|chrome|sunken)$/]",
        "message": "<MistPanel> tone must be one of 'panel' | 'chrome' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MistPanel'] > JSXAttribute[name.name='edge'] > Literal[value!=/^(?:all|top|bottom)$/]",
        "message": "<MistPanel> edge must be one of 'all' | 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoonLives'] > JSXAttribute > JSXIdentifier[name!=/^(?:lives|max|size|style|key|ref|className|style|children)$/]",
        "message": "<MoonLives> doesn't accept that prop. Declared props: lives, max, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaletteTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|cost|hotkey|mask|category|selected|budget|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PaletteTile> doesn't accept that prop. Declared props: name, cost, hotkey, mask, category, selected, budget, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaletteTile'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:cat-connector|cat-vertical|cat-chicane|cat-mob|cat-gimmick)$/]",
        "message": "<PaletteTile> category must be one of 'cat-connector' | 'cat-vertical' | 'cat-chicane' | 'cat-mob' | 'cat-gimmick'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|host|role|ready|self|onRole|onReady|style|key|ref|className|style|children)$/]",
        "message": "<PlayerRow> doesn't accept that prop. Declared props: name, host, role, ready, self, onRole, onReady, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerRow'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:nightmare|sleeper)$/]",
        "message": "<PlayerRow> role must be one of 'nightmare' | 'sleeper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RejectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:reason|style|key|ref|className|style|children)$/]",
        "message": "<RejectionLabel> doesn't accept that prop. Declared props: reason, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreboardRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|name|index|score|delta|rounds|woke|consumed|status|header|highlight|style|key|ref|className|style|children)$/]",
        "message": "<ScoreboardRow> doesn't accept that prop. Declared props: rank, name, index, score, delta, rounds, woke, consumed, status, header, highlight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SleeperMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|facing|selected|status|shape|scale|size|style|key|ref|className|style|children)$/]",
        "message": "<SleeperMarker> doesn't accept that prop. Declared props: index, name, facing, selected, status, shape, scale, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SleeperMarker'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:in-dream|awake|consumed)$/]",
        "message": "<SleeperMarker> status must be one of 'in-dream' | 'awake' | 'consumed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SleeperMarker'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SleeperMarker> scale must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|format|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, format, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerArc'] > JSXAttribute > JSXIdentifier[name!=/^(?:seconds|total|phase|label|size|urgent|style|key|ref|className|style|children)$/]",
        "message": "<TimerArc> doesn't accept that prop. Declared props: seconds, total, phase, label, size, urgent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|icon|tone|index|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: text, icon, tone, index, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:event|exit|danger|effect)$/]",
        "message": "<Toast> tone must be one of 'event' | 'exit' | 'danger' | 'effect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|checked|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, hint, checked, disabled, onChange, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
